    v_year TEXT;
    v_month TEXT;
    v_sequence INTEGER;
    v_transfer_no TEXT;
BEGIN
    v_year := TO_CHAR(NOW(), 'YY');
    v_month := TO_CHAR(NOW(), 'MM');
    
