CREATE FUNCTION public.post_warehouse_receipt(p_batch_id uuid, p_order_id uuid, p_company_id uuid, p_warehouse_org_id uuid, p_manufacturer_org_id uuid, p_receipt_type text, p_received_by uuid, p_items jsonb, p_idempotency_key text DEFAULT NULL::text, p_notes text DEFAULT NULL::text) RETURNS jsonb
