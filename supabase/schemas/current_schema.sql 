    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'pg_catalog', 'pg_temp'
    AS $_$
declare v_id uuid;
begin
  if p_scope_type !~ '^[a-z][a-z0-9_]*$' or p_scope_value is null or btrim(p_scope_value) = '' then
    raise exception 'sa_scope_invalid';
