CREATE FUNCTION public.sa_sod_holding_conflicts(p_user uuid, p_extra_role uuid DEFAULT NULL::uuid) RETURNS TABLE(rule_id uuid, rule_key text, enforcement text, mitigated boolean)
    LANGUAGE sql STABLE SECURITY DEFINER
    SET search_path TO 'pg_catalog', 'pg_temp'
    AS $$
