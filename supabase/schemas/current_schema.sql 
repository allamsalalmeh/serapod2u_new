--
-- TOC entry 1097 (class 1255 OID 68009)
-- Name: get_department_hierarchy(uuid); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.get_department_hierarchy(p_organization_id uuid) RETURNS TABLE(id uuid, dept_code text, dept_name text, parent_department_id uuid, manager_user_id uuid, manager_name text, manager_email text, user_count bigint, chart_order integer, sort_order integer, is_active boolean, depth integer, path text[])
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public', 'extensions', 'pg_temp'
    AS $$
BEGIN
  RETURN QUERY
  WITH RECURSIVE dept_tree AS (
    -- Base case: root departments (no parent)
    SELECT 
      d.id,
      d.dept_code,
      d.dept_name,
      d.parent_department_id,
      d.manager_user_id,
      u.full_name as manager_name,
      u.email as manager_email,
      d.chart_order,
      d.sort_order,
      d.is_active,
      0 as depth,
      ARRAY[d.dept_name]::text[] as path
    FROM departments d
    LEFT JOIN users u ON d.manager_user_id = u.id
    WHERE d.organization_id = p_organization_id
      AND d.parent_department_id IS NULL
    
    UNION ALL
    
    -- Recursive case: child departments
    SELECT 
      d.id,
      d.dept_code,
      d.dept_name,
      d.parent_department_id,
      d.manager_user_id,
      u.full_name as manager_name,
      u.email as manager_email,
      d.chart_order,
      d.sort_order,
      d.is_active,
      dt.depth + 1,
      dt.path || d.dept_name
    FROM departments d
    LEFT JOIN users u ON d.manager_user_id = u.id
    INNER JOIN dept_tree dt ON d.parent_department_id = dt.id
    WHERE d.organization_id = p_organization_id
  ),
  user_counts AS (
    SELECT department_id, COUNT(*) as cnt
    FROM users
    WHERE organization_id = p_organization_id
      AND is_active = true
      AND department_id IS NOT NULL
    GROUP BY department_id
  )
  SELECT 
    dt.id,
    dt.dept_code,
    dt.dept_name,
    dt.parent_department_id,
    dt.manager_user_id,
    dt.manager_name,
    dt.manager_email,
    COALESCE(uc.cnt, 0)::bigint as user_count,
    dt.chart_order,
    dt.sort_order,
    dt.is_active,
    dt.depth,
    dt.path
  FROM dept_tree dt
  LEFT JOIN user_counts uc ON dt.id = uc.department_id
  ORDER BY dt.path, dt.chart_order, dt.sort_order, dt.dept_name;
END;
$$;


--
-- TOC entry 1063 (class 1255 OID 68010)
-- Name: get_display_prefix_from_legacy(text, text); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.get_display_prefix_from_legacy(p_legacy_doc_no text, p_doc_type text DEFAULT NULL::text) RETURNS text
    LANGUAGE plpgsql IMMUTABLE
    AS $$
DECLARE
    v_prefix text;
BEGIN
    -- If doc_type is provided, use it directly
    IF p_doc_type IS NOT NULL THEN
        CASE UPPER(p_doc_type)
            WHEN 'PO' THEN RETURN 'PO';
            WHEN 'SO' THEN RETURN 'SO';
            WHEN 'DO' THEN RETURN 'DO';
            WHEN 'INVOICE' THEN RETURN 'SI';
            WHEN 'PAYMENT' THEN RETURN 'PV';
            WHEN 'RECEIPT' THEN RETURN 'RC';
            WHEN 'PAYMENT_REQUEST' THEN RETURN 'BR';
            WHEN 'CREDIT_NOTE' THEN RETURN 'CN';
            WHEN 'DEBIT_NOTE' THEN RETURN 'DN';
            WHEN 'GOODS_RECEIVED' THEN RETURN 'GR';
            WHEN 'DELIVERY_ORDER' THEN RETURN 'DO';
            WHEN 'QUOTATION' THEN RETURN 'QT';
            ELSE RETURN UPPER(p_doc_type);
        END CASE;
    END IF;
    
    -- Parse legacy format to determine prefix
    -- Legacy formats:
    -- Orders: ORD-HM-1225-01 (H2M/M2H orders), ORD-DH-1225-01 (D2H), ORD-SD-1225-01 (S2D)
    -- PO: PO-ORD-HM-1225-01
    -- Invoice: INV-HM-1225-01, INV-ORD-HM-1225-01
    -- Payment: PAY-HM-1225-01
    -- Receipt: RCT-HM-1225-01, RCPT-HM-1225-01
    -- Payment Request: REQ-HM-1225-01
    -- Goods Received: GR-ORD-HM-1225-01
    -- Delivery Order: DO-ORD-HM-1225-01, DO-ORD-DH-1225-01
    -- Credit Note: CN-ORD-HM-1225-01
    -- Debit Note: DN-ORD-HM-1225-01
    
    IF p_legacy_doc_no IS NULL THEN
        RETURN 'ORD';
    END IF;
    
    -- Check specific patterns for Sales Orders (ORD-DH-* for D2H, ORD-SD-* for S2D)
    -- These are D2H or S2D orders which should use SO prefix
    -- FIXED: Use alternation to match both ORD-DH- and ORD-SD- patterns
    IF p_legacy_doc_no ~* '^ORD-(DH|SD)-' THEN
        RETURN 'SO';
    END IF;
    
    -- Check for standard order patterns (ORD-HM-* or ORD-MH-*)
    -- These are H2M or M2H orders which should use ORD prefix
    IF p_legacy_doc_no ~* '^ORD-[HM][HM]-' THEN
        RETURN 'ORD';
    END IF;
    
    -- Check for PO pattern
    IF p_legacy_doc_no ~* '^PO-' THEN
        RETURN 'PO';
    END IF;
    
    -- Check for Invoice pattern
    IF p_legacy_doc_no ~* '^INV-' THEN
        RETURN 'SI';
    END IF;
    
    -- Check for Payment pattern
    IF p_legacy_doc_no ~* '^PAY-' THEN
        RETURN 'PV';
    END IF;
    
    -- Check for Receipt pattern (both RCT and RCPT)
    IF p_legacy_doc_no ~* '^RCT-' OR p_legacy_doc_no ~* '^RCPT-' THEN
        RETURN 'RC';
    END IF;
    
    -- Check for Payment Request pattern
    IF p_legacy_doc_no ~* '^REQ-' THEN
        RETURN 'BR';
    END IF;
    
    -- Check for Goods Received pattern
    IF p_legacy_doc_no ~* '^GR-' THEN
        RETURN 'GR';
    END IF;
    
    -- Check for Delivery Order pattern
    IF p_legacy_doc_no ~* '^DO-' THEN
        RETURN 'DO';
    END IF;
    
    -- Check for Credit Note pattern
    IF p_legacy_doc_no ~* '^CN-' THEN
        RETURN 'CN';
    END IF;
    
    -- Check for Debit Note pattern
    IF p_legacy_doc_no ~* '^DN-' THEN
        RETURN 'DN';
    END IF;
    
    -- Check for Quotation pattern
    IF p_legacy_doc_no ~* '^QT-' OR p_legacy_doc_no ~* '^QUOT-' THEN
        RETURN 'QT';
    END IF;
    
    -- Default to ORD for unknown patterns
    RETURN 'ORD';
END;
$$;


