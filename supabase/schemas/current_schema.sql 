--

CREATE FUNCTION public.wms_record_movement_from_summary(p_summary jsonb) RETURNS uuid
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public', 'extensions', 'pg_temp'
    AS $$
DECLARE v_variant uuid:=(p_summary->>'variant_id')::uuid; v_cfg uuid:=(p_summary->>'stock_config_id')::uuid;
 v_from uuid:=(p_summary->>'from_org')::uuid; v_to uuid:=(p_summary->>'to_org')::uuid; v_order uuid:=(p_summary->>'order_id')::uuid;
 v_units int:=(p_summary->>'units')::int; v_before int:=(p_summary->>'before')::int; v_after int:=(p_summary->>'after')::int;
 v_when timestamptz:=COALESCE((p_summary->>'shipped_at')::timestamptz,now()); v_id uuid; v_key text; v_creator uuid:=auth.uid(); v_company uuid;
BEGIN
  IF v_variant IS NULL OR v_cfg IS NULL OR v_from IS NULL OR v_units<=0 THEN RAISE EXCEPTION 'Invalid config-aware WMS summary'; END IF;
  v_key:=encode(digest(concat_ws('|',v_variant,v_cfg,v_from,v_to,v_order,v_units,to_char(v_when::date,'YYYY-MM-DD')),'sha256'),'hex');
  SELECT movement_id INTO v_id FROM public.wms_movement_dedup WHERE dedup_key=v_key; IF FOUND THEN RETURN v_id; END IF;
  IF COALESCE((p_summary->>'inventory_already_posted')::boolean,false) THEN
    SELECT id INTO v_id FROM public.stock_movements WHERE reference_type='order' AND reference_id=v_order
      AND variant_id=v_variant AND stock_config_id=v_cfg AND movement_type='order_fulfillment' ORDER BY created_at DESC LIMIT 1;
    IF v_id IS NULL THEN RAISE EXCEPTION 'Expected exact outbound posting is missing'; END IF;
  ELSE
    IF v_creator IS NULL THEN SELECT created_by INTO v_creator FROM public.orders WHERE id=v_order; END IF;
    v_company:=public.get_company_id(v_from);
    INSERT INTO public.stock_movements(variant_id,stock_config_id,from_organization_id,to_organization_id,movement_type,
      quantity_change,quantity_before,quantity_after,reference_type,reference_id,company_id,created_by,created_at,notes)
    VALUES(v_variant,v_cfg,v_from,NULLIF(v_to,v_from),'order_fulfillment',-v_units,v_before,v_after,'order',v_order,
      v_company,v_creator,v_when,'WMS QR shipment resolved through order item configuration') RETURNING id INTO v_id;
  END IF;
  INSERT INTO public.wms_movement_dedup(dedup_key,movement_id) VALUES(v_key,v_id) ON CONFLICT DO NOTHING;
  RETURN v_id;
END $$;


--
-- TOC entry 1650 (class 1255 OID 68561)
-- Name: wms_record_movements_from_items(jsonb); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.wms_record_movements_from_items(p_items jsonb) RETURNS jsonb
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public', 'extensions', 'pg_temp'
    AS $$
DECLARE
  elem   jsonb;
  v_id   uuid;
  v_ids  jsonb := '[]'::jsonb;
BEGIN
  -- Case 1: { "items": [ {...}, {...} ] }
  IF jsonb_typeof(p_items->'items') = 'array' THEN
    FOR elem IN
      SELECT value FROM jsonb_array_elements(p_items->'items')
    LOOP
      v_id := public.wms_record_movement_from_summary(elem);
      v_ids := v_ids || jsonb_build_array(v_id);
    END LOOP;

  -- Case 2: plain array: [ {...}, {...} ]
  ELSIF jsonb_typeof(p_items) = 'array' THEN
    FOR elem IN
      SELECT value FROM jsonb_array_elements(p_items)
    LOOP
      v_id := public.wms_record_movement_from_summary(elem);
      v_ids := v_ids || jsonb_build_array(v_id);
    END LOOP;

  -- Case 3: single object
  ELSE
    v_id := public.wms_record_movement_from_summary(p_items);
    v_ids := v_ids || jsonb_build_array(v_id);
  END IF;

  RETURN jsonb_build_object('movement_ids', v_ids);
END;
$$;


--
-- TOC entry 1580 (class 1255 OID 68562)
-- Name: wms_resolve_ship_to(uuid, uuid, text, public.order_type, uuid, uuid); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.wms_resolve_ship_to(p_shipped_to_distributor_id uuid, p_buyer_org_id uuid, p_buyer_org_type text, p_order_type public.order_type, p_order_warehouse_org_id uuid, p_case_warehouse_org_id uuid) RETURNS uuid
    LANGUAGE plpgsql STABLE
    AS $$
DECLARE
  v_buyer_type text := p_buyer_org_type;
  v_from_type  text;
BEGIN
  IF p_shipped_to_distributor_id IS NOT NULL THEN
    RETURN p_shipped_to_distributor_id;
  END IF;

  IF p_buyer_org_id IS NULL THEN
    RETURN NULL;
  END IF;

  IF v_buyer_type IS NULL THEN
    SELECT org_type_code INTO v_buyer_type
    FROM public.organizations
    WHERE id = p_buyer_org_id;
  END IF;

  IF p_case_warehouse_org_id IS NOT NULL THEN
    SELECT org_type_code INTO v_from_type
    FROM public.organizations
    WHERE id = p_case_warehouse_org_id;
  END IF;

  -- Non-HQ buyers always receive the stock
  IF v_buyer_type IS NULL OR v_buyer_type <> 'HQ' THEN
    RETURN p_buyer_org_id;
  END IF;

  -- HQ can receive stock when it is explicitly the warehouse of record
  IF p_case_warehouse_org_id IS NOT NULL AND p_case_warehouse_org_id = p_buyer_org_id THEN
    RETURN p_buyer_org_id;
  END IF;

  IF p_order_warehouse_org_id IS NOT NULL AND p_order_warehouse_org_id = p_buyer_org_id THEN
    RETURN p_buyer_org_id;
  END IF;

  -- HQ may receive goods directly from manufacturer on H2M orders
  IF v_from_type = 'MFG' AND p_order_type = 'H2M' THEN
    RETURN p_buyer_org_id;
  END IF;

  RETURN NULL;
END;
$$;


--
-- TOC entry 1219 (class 1255 OID 68563)
-- Name: wms_reverse_manual_movement(uuid, text, uuid); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.wms_reverse_manual_movement(p_movement_id uuid, p_reversal_reason text DEFAULT 'Rollback of manual shipment due to downstream failure'::text, p_override_user uuid DEFAULT NULL::uuid) RETURNS jsonb
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public', 'pg_temp'
    AS $$
DECLARE
    v_original public.stock_movements%ROWTYPE;
    v_reversal_id uuid;
    v_created_by uuid;
    v_qty integer;
BEGIN
  /* sa-guard:inventory.adjustment.post */
  PERFORM public.sa_require_operation('inventory.adjustment.post', jsonb_build_object('organization_id', (SELECT coalesce(m.from_organization_id, m.to_organization_id) FROM public.stock_movements m WHERE m.id = p_movement_id), 'warehouse_id', (SELECT coalesce(m.from_organization_id, m.to_organization_id) FROM public.stock_movements m WHERE m.id = p_movement_id)), 'stock_movement', p_movement_id::text);
    SELECT *
    INTO v_original
    FROM public.stock_movements
    WHERE id = p_movement_id
      AND movement_type = 'manual_out';

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Manual_out movement % not found', p_movement_id;
    END IF;

    v_created_by := COALESCE(p_override_user, v_original.created_by);
    v_qty := ABS(v_original.quantity_change);

    IF v_qty <= 0 THEN
        RAISE EXCEPTION 'Cannot reverse manual movement % with zero quantity', p_movement_id;
    END IF;

    v_reversal_id := public.record_stock_movement(
        p_movement_type      := 'manual_in',
        p_variant_id         := v_original.variant_id,
        p_organization_id    := COALESCE(v_original.from_organization_id, v_original.to_organization_id),
        p_quantity_change    := v_qty,
        p_unit_cost          := v_original.unit_cost,
        p_manufacturer_id    := v_original.manufacturer_id,
        p_warehouse_location := v_original.warehouse_location,
        p_reason             := p_reversal_reason,
        p_notes              := CONCAT('Rollback of manual movement ', p_movement_id),
        p_reference_type     := v_original.reference_type,
        p_reference_id       := v_original.reference_id,
        p_reference_no       := v_original.reference_no,
        p_company_id         := v_original.company_id,
        p_created_by         := v_created_by
    );

    UPDATE public.stock_movements
    SET notes = CONCAT(
        COALESCE(notes, ''),
        CASE WHEN notes IS NULL OR notes = '' THEN '' ELSE ' ' END,
        '[Rolled back via ', v_reversal_id, ']'::text
    )
    WHERE id = v_original.id;

    RETURN jsonb_build_object(
        'reversal_movement_id', v_reversal_id,
        'reversed_movement_id', v_original.id
    );
END;
$$;


