--

CREATE FUNCTION public.distributor_can_receive_stock_config(p_distributor_org_id uuid, p_stock_config_id uuid) RETURNS boolean
    LANGUAGE sql STABLE
    SET search_path TO 'public', 'pg_temp'
    AS $$
  SELECT CASE
    WHEN c.id IS NULL OR c.status <> 'active' OR NOT c.allow_so
      OR c.requires_repacking_before_sale OR c.packaging='old_box' THEN false
    WHEN c.volume_ml=50 AND c.packaging='new_box' THEN COALESCE(e.allow_50ml_new_box,false)
    WHEN c.volume_ml=20 AND c.packaging='new_box' THEN true
    WHEN c.volume_ml IS NULL AND c.packaging IS NULL THEN true
    ELSE false END
  FROM public.inventory_stock_configurations c
  LEFT JOIN public.distributor_stock_config_eligibility e
    ON e.distributor_org_id=p_distributor_org_id
  WHERE c.id=p_stock_config_id
$$;


--
-- TOC entry 1861 (class 1255 OID 67926)
-- Name: documents_ensure_company_id(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.documents_ensure_company_id() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public', 'extensions', 'pg_temp'
    AS $$
BEGIN
    -- If company_id is null and order_id is provided, get company_id from the order
    IF NEW.company_id IS NULL AND NEW.order_id IS NOT NULL THEN
        SELECT company_id INTO NEW.company_id
        FROM public.orders
        WHERE id = NEW.order_id;
        
        IF NEW.company_id IS NOT NULL THEN
            RAISE NOTICE 'Auto-populated company_id from order for doc %', NEW.doc_no;
        END IF;
    END IF;
    
    -- If still null and issued_by_org_id is set, get company from org hierarchy
    IF NEW.company_id IS NULL AND NEW.issued_by_org_id IS NOT NULL THEN
        NEW.company_id := public.get_company_id(NEW.issued_by_org_id);
        
        IF NEW.company_id IS NOT NULL THEN
            RAISE NOTICE 'Auto-populated company_id from org hierarchy for doc %', NEW.doc_no;
        END IF;
    END IF;
    
    RETURN NEW;
END;
$$;


