  RETURN v_role_level = 1
    OR coalesce(v_overrides->'allow', '[]'::jsonb) ? 'post_stock_count'
    OR coalesce(v_role_permissions->>'post_stock_count', 'false')::boolean
    OR coalesce(v_role_permissions, '[]'::jsonb) ? 'post_stock_count';
