       or new.permission_overrides = '{"allow": [], "deny": []}'::jsonb then
      return new;
    end if;
  end if;
  raise exception 'legacy_authorization_store_read_only'
    using errcode = '42501', hint = 'Authorization is administered in Security & Access.';
end $$;


