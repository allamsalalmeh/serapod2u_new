CREATE FUNCTION public.sa_cached_actor_allows(p_permission text, p_context jsonb) RETURNS boolean
    LANGUAGE plpgsql STABLE SECURITY DEFINER
    SET search_path TO 'pg_catalog', 'pg_temp'
    AS $$
declare
  v_uid uuid := auth.uid();
  v_key text;
  v_val text;
begin
  if v_uid is null then return false; end if;
  v_key := 'sa_cache.d' || md5(coalesce(current_setting('sa_cache.epoch', true), '') || '|' || v_uid::text || '|' || p_permission || '|' || coalesce(p_context::text, ''));
