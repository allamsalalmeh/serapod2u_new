  /* sa-guard:hr.payroll.release */
  PERFORM public.sa_require_operation('hr.payroll.release', jsonb_build_object('organization_id', (SELECT r.organization_id FROM public.hr_payroll_runs r WHERE r.id = p_run_id)), 'payroll_run', p_run_id::text);
  -- Load payroll run
  SELECT * INTO v_run
  FROM public.hr_payroll_runs
  WHERE id = p_run_id;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'Payroll run not found: %', p_run_id;
  END IF;

  IF v_run.status <> 'approved' THEN
    RAISE EXCEPTION 'Payroll run is not approved (status: %)', v_run.status;
  END IF;

