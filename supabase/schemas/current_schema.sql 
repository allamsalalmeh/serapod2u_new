CREATE FUNCTION public.sa_assert_staff_actor(p_max_role_level integer, p_require_hq boolean DEFAULT false, p_claimed_actor uuid DEFAULT NULL::uuid) RETURNS void
    LANGUAGE plpgsql STABLE SECURITY DEFINER
    SET search_path TO 'pg_catalog', 'public', 'pg_temp'
    AS $$
