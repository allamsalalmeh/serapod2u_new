    IF NOT FOUND THEN
      -- A previous attempt with this id already committed: replay, don't duplicate.
      SELECT * INTO v_order FROM public.orders WHERE id = p_order_id;
      IF NOT FOUND OR v_order.created_by IS DISTINCT FROM v_actor THEN
