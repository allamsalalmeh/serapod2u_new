  RETURN jsonb_build_object(
    'return_case_id', p_return_case_id,
    'return_no', v_case.return_no,
    'warehouse_id', v_case.return_warehouse_id,
    'posted_lines', v_posted,
    'skipped_lines', v_skipped,
    'historically_excluded', false
