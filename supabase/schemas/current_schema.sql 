    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public', 'extensions', 'pg_temp'
    AS $$
declare
  v_thread_id uuid;
begin
  select id
    into v_thread_id
  from public.support_threads
  where created_by_user_id = p_user_id
