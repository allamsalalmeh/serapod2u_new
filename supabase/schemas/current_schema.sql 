      and c.status = 'posted'
  ) then
    raise exception 'inventory_cutoff_transaction_historically_excluded: transaction % was excluded by a posted Opening Balance and cannot post inventory through its original path.', new.reference_id;
  end if;
  return new;
end;
$$;


