# ========================================
# USER REQUESTED EXCLUSIONS (LOCAL ONLY)
# ========================================

# SQL files (Keep local only)
*.sql
!supabase/migrations/**/*.sql
# Cutover runbook scripts are versioned: they are executed against staging and
# production by hand, so the reviewed text and the executed text must match.
!supabase/operations/**/*.sql

# Markdown files (Keep local only)
*.md
!supabase/migrations/**/*.md

# Data files
*.csv
*.xlsx
*.xls

# Log files
*.log

# Local/Temp folders
playground/
local_test/
sql_backup/
experimental/
tmp/
.tmp/

# Local secret/backups artifacts
*.dump
*.backup
*.bak
*.tar
*.tar.gz
*.tgz
*.zip
temp/
z_*

# Scripts and Docs at root (Keep local/organized)
/scripts/
/docs/
*.sh
*.py

# Reporting data coverage audit docs are intentionally tracked
!/docs/
!/docs/reporting-data-coverage-audit/
!/docs/reporting-data-coverage-audit/**

# RoadTour module specifications are implementation artifacts
!/docs/roadtourmodules/
!/docs/roadtourmodules/33-roadtour-event-product-category-experience.md

# HQ inventory cutover runbooks are implementation artifacts
!/docs/runbooks/
!/docs/runbooks/**

# Event Management planning docs are implementation artifacts
!/docs/event-management/
!/docs/event-management/**


# Local reporting audit exports stay private
/exports/reporting-audit/

# Test files
*.test.ts
*.test.js
*.spec.ts
*.spec.js
**/__tests__/**
**/tests/**
**/__mocks__/**

# Phase 0A security containment regression tests are implementation artifacts
!/app/src/lib/actions.security.test.ts
!/app/src/lib/security/user-profile-updates.test.ts
!/app/src/lib/security/phase0a-containment-contract.test.ts
!/app/src/lib/warehouse/shipment-authorization.test.ts
!/app/src/app/api/warehouse/confirm-shipment/route.security.test.ts

# Phase 0B security containment evidence and regression tests
!/docs/security/phase0b-*.md
!/supabase/tests/security/
!/supabase/tests/security/phase0b/
!/supabase/tests/security/phase0b/*.sql
!/app/src/app/api/warehouse/shipment-routes.security.test.ts
!/app/src/lib/security/phase0b-containment-contract.test.ts
!/app/src/lib/security/phase0b-public-endpoints.test.ts
!/app/src/app/api/admin/store/orders/route.security.test.ts

# Event Management module tests are implementation artifacts
!/app/src/modules/event-management/**/*.test.ts
!/app/src/app/api/event-management/**/*.test.ts
!/supabase/tests/security/event-management/
!/supabase/tests/security/event-management/**/*.sql

